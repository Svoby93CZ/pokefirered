ViridianCity_School_Text_TryingToMemorizeNotes::
    .string "Uf! Snažím se naučit nazpaměť\n"
    .string "všechny poznámky.$"

ViridianCity_School_Text_ReadBlackboardCarefully::
    .string "Tak jo!\p"
    .string "Nezapomeň si pozorně přečíst, co\n"
    .string "je na tabuli!$"

ViridianCity_School_Text_NotebookFirstPage::
    .string "Podíváme se do sešitu.\p"
    .string "První strana…\p"
    .string "POKé BALLY slouží k chytání\n"
    .string "POKéMONŮ.\p"
    .string "V týmu můžeš mít až šest\n"
    .string "POKéMONŮ.\p"
    .string "Lidem, kteří vychovávají POKéMONY\n"
    .string "a bojují s nimi, se říká TRENÉŘI.$"

ViridianCity_School_Text_NotebookSecondPage::
    .string "Druhá strana…\p"
    .string "Zdravého POKéMONA je těžké chytit,\n"
    .string "tak ho nejdřív oslab.\p"
    .string "Oslabíš ho otravou, popálením nebo\n"
    .string "jiným problémem se stavem.$"

ViridianCity_School_Text_NotebookThirdPage::
    .string "Třetí strana…\p"
    .string "POKéMON TRENÉŘI vyhledávají\n"
    .string "ostatní a utkávají se v soubojích\l"
    .string "POKéMONŮ.\p"
    .string "Pro TRENÉRY je chuť vítězství\n"
    .string "opravdu sladká.\p"
    .string "Ve všech POKéMON STADIONECH se\n"
    .string "neustále bojuje.$"

ViridianCity_School_Text_NotebookFourthPage::
    .string "Čtvrtá strana…\p"
    .string "Nejvyšší cíl všech POKéMON\n"
    .string "TRENÉRŮ je prostý.\p"
    .string "Porazit osm nejlepších VŮDCŮ\n"
    .string "POKéMON STADIONŮ.\p"
    .string "Tím si vybojuješ právo utkat se…\p"
    .string "S ELITE FOUR z POKéMON LEAGUE!$"

ViridianCity_School_Text_TurnThePage::
    .string "Otočit stránku?$"

ViridianCity_School_Text_HeyDontLookAtMyNotes::
    .string "DÍVKA: Hej!\n"
    .string "Nekoukej mi do poznámek!$"

ViridianCity_School_Text_BlackboardListsStatusProblems::
    .string "Na tabuli jsou vypsané problémy se\n"
    .string "stavem POKéMONŮ v boji.$"

ViridianCity_School_Text_ReadWhichTopic::
    .string "Které téma si chceš přečíst?$"

ViridianCity_School_Text_ExplainSleep::
    .string "Spící POKéMON nemůže útočit.\p"
    .string "POKéMONI spí i po souboji.\p"
    .string "Probudíš je pomocí AWAKENING.$"

ViridianCity_School_Text_ExplainBurn::
    .string "Popálení snižuje sílu ÚTOKU. Navíc\n"
    .string "POKéMON neustále ztrácí HP.\p"
    .string "Popálení po souboji trvá.\n"
    .string "Vyléčíš ho pomocí BURN HEAL.$"

ViridianCity_School_Text_ExplainPoison::
    .string "Otrávenému POKéMONOVI neustále\n"
    .string "ubývá zdraví.\p"
    .string "Otrava po souboji trvá.\n"
    .string "Vyléčíš ji pomocí ANTIDOTE!$"

ViridianCity_School_Text_ExplainFreeze::
    .string "Zmrzlý POKéMON se nemůže vůbec\n"
    .string "hýbat.\p"
    .string "Zůstane zmrzlý i po skončení\n"
    .string "souboje.\p"
    .string "Trpícího POKéMONA rozmrazíš\n"
    .string "pomocí ICE HEAL.$"

ViridianCity_School_Text_ExplainParalysis::
    .string "Paralýza snižuje RYCHLOST a může\n"
    .string "POKéMONOVI bránit v pohybu.\p"
    .string "Paralýza po souboji trvá.\n"
    .string "Vyléčíš ji pomocí PARLYZ HEAL.$"

