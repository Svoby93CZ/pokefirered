Route8_Text_AidanIntro::
    .string "V POKéMONECH ti to jde, ale jakou\n"
    .string "máš známku z chemie?$"

Route8_Text_AidanDefeat::
    .string "Au!\n"
    .string "Tavba jádra!$"

Route8_Text_AidanPostBattle::
    .string "Ve škole jsem lepší než tady!$"

Route8_Text_StanIntro::
    .string "Tak jo!\n"
    .string "Zahrajeme si!$"

Route8_Text_StanDefeat::
    .string "Sakra!\n"
    .string "Nevyšlo to!$"

Route8_Text_StanPostBattle::
    .string "Dneska mi nic nevychází.$"

Route8_Text_GlennIntro::
    .string "Pro tvou informaci: bez strategie\n"
    .string "se tady nevyhrává!$"

Route8_Text_GlennDefeat::
    .string "To není logické!$"

Route8_Text_GlennPostBattle::
    .string "Nejdřív GRIMER…a…\n"
    .string "…a…pak…$"

Route8_Text_PaigeIntro::
    .string "Mám ráda POKéMONY NIDORAN, tak je\n"
    .string "sbírám!$"

Route8_Text_PaigeDefeat::
    .string "Proč?\n"
    .string "Proč??$"

Route8_Text_PaigePostBattle::
    .string "Když POKéMONI vyrostou, jsou\n"
    .string "oškliví! Neměli by se vyvíjet.$"

Route8_Text_LeslieIntro::
    .string "Škola je zábava, ale POKéMONI\n"
    .string "taky.$"

Route8_Text_LeslieDefeat::
    .string "Teď je mi jasné, že bych měl\n"
    .string "zůstat u školy.$"

Route8_Text_LesliePostBattle::
    .string "Chtěl jsem se pro změnu nadýchat\n"
    .string "čerstvého vzduchu, ale…\p"
    .string "Kvůli bránám do SAFFRON tu trčíme.$"

Route8_Text_AndreaIntro::
    .string "MEOWTH je tak roztomilý, mňau,\n"
    .string "mňau, mňau!$"

Route8_Text_AndreaDefeat::
    .string "Mňaaaaau!$"

Route8_Text_AndreaPostBattle::
    .string "PIDGEY a RATTATA jsou podle mě\n"
    .string "taky roztomilí!$"

Route8_Text_MeganIntro::
    .string "Musíme vypadat hloupě, jak tu\n"
    .string "takhle stojíme.$"

Route8_Text_MeganDefeat::
    .string "Koukej, jak dopadli moji chudáčci\n"
    .string "roztomilí POKéMONI!$"

Route8_Text_MeganPostBattle::
    .string "Strážný u brány do SAFFRON nás\n"
    .string "nechce pustit.\p"
    .string "Vím, že jen dělá svou práci, ale\n"
    .string "přijde mi zlý.$"

Route8_Text_RichIntro::
    .string "Jsem potulný hráčský borec!$"

Route8_Text_RichDefeat::
    .string "Velká šance je pryč!$"

Route8_Text_RichPostBattle::
    .string "Hry a POKéMONI jsou jako burské\n"
    .string "oříšky! Prostě nemůžu přestat!$"

Route8_Text_JuliaIntro::
    .string "Který POKéMON je roztomilý, kulatý\n"
    .string "a chlupatý?$"

Route8_Text_JuliaDefeat::
    .string "Přestaň!\p"
    .string "Neubližuj mému CLEFAIRY!$"

Route8_Text_JuliaPostBattle::
    .string "Četla jsem, že se CLEFAIRY vyvine,\n"
    .string "když přijde do styku s MOON STONE.\p"
    .string "Četla jsem to v časopise POKéMON\n"
    .string "JOURNAL. Je to vůbec pravda?$"

Route8_Text_UndergroundPathSign::
    .string "UNDERGROUND PATH\n"
    .string "CELADON CITY - LAVENDER TOWN$"

Route8_Text_EliIntro::
    .string "ELI: Síla dvojčat je fantastická.\n"
    .string "Víš o tom?$"

Route8_Text_EliDefeat::
    .string "ELI: Ale…\n"
    .string "Vždyť jsme použily sílu dvojčat…$"

Route8_Text_EliPostBattle::
    .string "ELI: Své POKéMONY jsem chytala\n"
    .string "s ANNE!$"

Route8_Text_EliNotEnoughMons::
    .string "ELI: Nemůžeme bojovat, když nemáš\n"
    .string "dva POKéMONY.$"

Route8_Text_AnneIntro::
    .string "ANNE: Ohromíme tě silou dvojčat!$"

Route8_Text_AnneDefeat::
    .string "ANNE: Naše síla dvojčat…$"

Route8_Text_AnnePostBattle::
    .string "ANNE: Vychovávám POKéMONY s ELI.$"

Route8_Text_AnneNotEnoughMons::
    .string "ANNE: Ahoj, ahoj! Pojď bojovat!\n"
    .string "Ale přiveď dva POKéMONY.$"

Route8_Text_RicardoIntro::
    .string "Moje motorka zlobí, kámo.$"

Route8_Text_RicardoDefeat::
    .string "Ach jo, kámo.\n"
    .string "Tohle mě nebaví.$"

Route8_Text_RicardoPostBattle::
    .string "Do kol se mi namotala tráva, kámo.$"

Route8_Text_JarenIntro::
    .string "Uhni z cesty, nebo tě přejedu!$"

Route8_Text_JarenDefeat::
    .string "To myslíš vážně, prcku?$"

Route8_Text_JarenPostBattle::
    .string "Nemysli si, že jsi kdovíco, jen\n"
    .string "kvůli tomuhle.$"
