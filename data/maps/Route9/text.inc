Route9_Text_AliciaIntro::
    .string "Máš s sebou POKéMONY!\n"
    .string "Teď mi neutečeš!$"

Route9_Text_AliciaDefeat::
    .string "Tohle jsem nečekala…$"

Route9_Text_AliciaPostBattle::
    .string "Tunel kousek odsud je uvnitř úplně\n"
    .string "černý.\p"
    .string "Bez útoku FLASH tudy neprojdeš.$"

Route9_Text_ChrisIntro::
    .string "Kdo to tu chodí s tak pěknými\n"
    .string "POKéMONY?$"

Route9_Text_ChrisDefeat::
    .string "Zhasnuto!$"

Route9_Text_ChrisPostBattle::
    .string "Jen jdi dál!$"

Route9_Text_DrewIntro::
    .string "Jdu přes ROCK TUNNEL do LAVENDER…$"

Route9_Text_DrewDefeat::
    .string "Nemám na to…$"

Route9_Text_DrewPostBattle::
    .string "Taky míříš do ROCK TUNNEL?$"

Route9_Text_CaitlinIntro::
    .string "Ať tě ani nenapadne mě podceňovat!$"

Route9_Text_CaitlinDefeat::
    .string "Ne!\n"
    .string "Na tebe nemám.$"

Route9_Text_CaitlinPostBattle::
    .string "Talent ti zjevně nechybí. Hodně\n"
    .string "štěstí!$"

Route9_Text_JeremyIntro::
    .string "Bwahaha!\n"
    .string "Skvělé! Zrovna jsem se nudil, víš!$"

Route9_Text_JeremyDefeat::
    .string "Jen přidej, víš!\p"
    .string "Á, počkat.\n"
    .string "Už nemám POKéMONY!$"

Route9_Text_JeremyPostBattle::
    .string "Postavit se mi chtělo pořádnou\n"
    .string "kuráž, víš?$"

Route9_Text_BriceIntro::
    .string "Chachacha!\n"
    .string "Ty máš ale kuráž!$"

Route9_Text_BriceDefeat::
    .string "Co to bylo?$"

Route9_Text_BricePostBattle::
    .string "Chachacha!\n"
    .string "Děti mají být odolné!$"

Route9_Text_BrentIntro::
    .string "Každý den jsem brzy vstával,\n"
    .string "abych své POKéMONY vychoval už od\l"
    .string "kukel!$"

Route9_Text_BrentDefeat::
    .string "COŽE?\p"
    .string "To byla úplná ztráta času!$"

Route9_Text_BrentPostBattle::
    .string "Abych zesílil, musím sbírat víc\n"
    .string "než jen brouky…$"

Route9_Text_AlanIntro::
    .string "Chachachacha!\n"
    .string "Jen pojď!$"

Route9_Text_AlanDefeat::
    .string "Chachachacha!\n"
    .string "Byla to férová porážka!$"

Route9_Text_AlanPostBattle::
    .string "Chachachacha!\n"
    .string "My bodří chlapi se pořád smějem!$"

Route9_Text_ConnerIntro::
    .string "Do toho, moji super BUG POKéMONI!$"

Route9_Text_ConnerDefeat::
    .string "Moji brouci…$"

Route9_Text_ConnerPostBattle::
    .string "Komu se nelíbí BUG POKéMONI, ten\n"
    .string "mi leze na nervy!$"

