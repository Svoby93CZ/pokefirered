Text_DoubleEdgeTeach::
    .string "Probojovat se tak odvážně přes\n"
    .string "VICTORY ROAD, to si zaslouží\l"
    .string "uznání.\p"
    .string "Na počest tvého výkonu naučím\n"
    .string "tvého POKéMONA DOUBLE-EDGE.\p"
    .string "Mám ho tu techniku naučit?$"

Text_DoubleEdgeDeclined::
    .string "Tu techniku naučím kdykoli.$"

Text_DoubleEdgeWhichMon::
    .string "Kterého POKéMONA mám naučit\n"
    .string "DOUBLE-EDGE?$"

Text_DoubleEdgeTaught::
    .string "Udrž si ten zápal i v POKéMON\n"
    .string "LEAGUE!\p"
    .string "Vrhni se na ně a vyřiď je!$"

VictoryRoad_3F_Text_GeorgeIntro::
    .string "Slyšel jsem zvěsti o zázračném\n"
    .string "dítěti.$"

VictoryRoad_3F_Text_GeorgeDefeat::
    .string "Zvěsti byly pravdivé!$"

VictoryRoad_3F_Text_GeorgePostBattle::
    .string "Takže to ty máš na svědomí porážku\n"
    .string "GIOVANNIHO z TEAM ROCKET?$"

VictoryRoad_3F_Text_AlexaIntro::
    .string "TRENÉŘI žijí pro hledání\n"
    .string "silnějších soupeřů.$"

VictoryRoad_3F_Text_AlexaDefeat::
    .string "Ach!\n"
    .string "Taková síla!$"

VictoryRoad_3F_Text_AlexaPostBattle::
    .string "Tvrdými souboji člověk sílí.$"

VictoryRoad_3F_Text_CarolineIntro::
    .string "Ukážu ti, jaké máš kvality. Kdepak!$"

VictoryRoad_3F_Text_CarolineDefeat::
    .string "Zuřím!$"

VictoryRoad_3F_Text_CarolinePostBattle::
    .string "Teď už vím, jaké kvality mám já…$"

VictoryRoad_3F_Text_ColbyIntro::
    .string "Tudy smějí projít jen vyvolení!$"

VictoryRoad_3F_Text_ColbyDefeat::
    .string "Tomu nevěřím!$"

VictoryRoad_3F_Text_ColbyPostBattle::
    .string "Všichni TRENÉŘI tady míří do\n"
    .string "POKéMON LEAGUE.\p"
    .string "Nepolevuj v ostražitosti.$"

VictoryRoad_3F_Text_RayIntro::
    .string "RAY: Spolu jsme my dva předurčeni\n"
    .string "k velikosti!$"

VictoryRoad_3F_Text_RayDefeat::
    .string "RAY: Absurdní!\n"
    .string "To nemůže být!$"

VictoryRoad_3F_Text_RayPostBattle::
    .string "RAY: Prohráli jsme.\n"
    .string "Velikost nám stále uniká…$"

VictoryRoad_3F_Text_RayNotEnoughMons::
    .string "RAY: Spolu my dva usilujeme\n"
    .string "o vrchol.\p"
    .string "Do souboje s námi potřebuješ dva\n"
    .string "POKéMONY.$"

VictoryRoad_3F_Text_TyraIntro::
    .string "TYRA: Snažíme se spolu stát\n"
    .string "šampiony.$"

VictoryRoad_3F_Text_TyraDefeat::
    .string "TYRA: Ach, ale…$"

VictoryRoad_3F_Text_TyraPostBattle::
    .string "TYRA: Teď vím, že síla může mít\n"
    .string "nekonečně mnoho podob.$"

VictoryRoad_3F_Text_TyraNotEnoughMons::
    .string "TYRA: S jedním POKéMONEM s námi\n"
    .string "bojovat nemůžeš.$"

