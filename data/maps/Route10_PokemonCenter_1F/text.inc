Route10_PokemonCenter_1F_Text_EveryTypeStrongerThanOthers::
    .string "Typy POKéMONŮ si proti sobě vedou\n"
    .string "různě.\p"
    .string "Každý typ je silnější proti\n"
    .string "některým typům a slabší proti\l"
    .string "jiným.$"

Route10_PokemonCenter_1F_Text_NuggetUselessSoldFor5000::
    .string "NUGGET je úplně k ničemu. Tak jsem\n"
    .string "ho prodal za ¥5000.$"

Route10_PokemonCenter_1F_Text_HeardGhostsHauntLavender::
    .string "Slyšel jsem, že v LAVENDER TOWN\n"
    .string "straší duchové.$"

Route10_PokemonCenter_1F_Text_GiveEverstoneIfCaught20Mons::
    .string "Á… {PLAYER}!\n"
    .string "Tebe jsem hledal!\p"
    .string "To jsem já, jeden\n"
    .string "z všudypřítomných ASISTENTŮ\l"
    .string "PROF. OAKA.\p"
    .string "Když máš v POKéDEXU kompletní\n"
    .string "údaje o dvaceti druzích, mám ti od\l"
    .string "PROF. OAKA dát odměnu.\p"
    .string "Svěřil mi tenhle EVERSTONE.\p"
    .string "Tak se tě zeptám, {PLAYER}.\p"
    .string "Máš údaje aspoň o dvaceti druzích\n"
    .string "POKéMONŮ?$"

Route10_PokemonCenter_1F_Text_GreatHereYouGo::
    .string "Skvělé! Chycených druhů POKéMONŮ:\n"
    .string "{STR_VAR_3}!\p"
    .string "Gratuluji!\n"
    .string "Tady máš!$"

Route10_PokemonCenter_1F_Text_ReceivedEverstoneFromAide::
    .string "{PLAYER} dostává od ASISTENTA\n"
    .string "EVERSTONE.$"

Route10_PokemonCenter_1F_Text_ExplainEverstone::
    .string "Vývoj POKéMONŮ určitě pomáhá plnit\n"
    .string "POKéDEX.\p"
    .string "Někdy ale možná nechceš, aby se\n"
    .string "určitý POKéMON vyvinul.\p"
    .string "V tom případě dej tomu POKéMONOVI\n"
    .string "EVERSTONE.\p"
    .string "Podle PROFESORA tak vývoji\n"
    .string "zabráníš.$"

