CeruleanCity_Text_RivalIntro::
    .string "{RIVAL}: Čau! {PLAYER}!\p"
    .string "Pořád se tu ještě ploužíš?\p"
    .string "Mně se daří skvěle! Chytil jsem\n"
    .string "spoustu silných a chytrých\l"
    .string "POKéMONŮ!\p"
    .string "Ukaž, co máš ty, {PLAYER}!$"

CeruleanCity_Text_RivalDefeat::
    .string "Hej!\n"
    .string "Klid!\l"
    .string "Už je po všem!$"

CeruleanCity_Text_RivalPostBattle::
    .string "{RIVAL}: Hele, víš co?\p"
    .string "Byl jsem u BILLA a nechal si\n"
    .string "ukázat jeho vzácné POKéMONY.\p"
    .string "V POKéDEXU mi tím přibyla spousta\n"
    .string "stránek!\p"
    .string "BILL je přece světoznámý\n"
    .string "POKéMANIAK.\p"
    .string "Taky vymyslel systém ukládání\n"
    .string "POKéMONŮ v PC.\p"
    .string "Když jeho systém používáš, běž mu\n"
    .string "poděkovat.\p"
    .string "Tak, já už musím vyrazit!\n"
    .string "Zatím čau!$"

CeruleanCity_Text_OhRightLittlePresentAsFavor::
    .string "Á, jasně.\p"
    .string "Je mi tě líto. Vážně. Pořád se jen\n"
    .string "ploužíš za mnou.\p"
    .string "Tak tady máš malý dárek.$"

CeruleanCity_Text_ExplainFameCheckerSmellYa::
    .string "Pro takovou drbnu jako ty… Ta věc\n"
    .string "je jako dělaná.\p"
    .string "Mně k ničemu není, protože ostatní\n"
    .string "mě vůbec nezajímají.\p"
    .string "Tak, teď už fakt mizím. Čau!$"

@ RB translation: "Heh! You're no match for my genius!"
CeruleanCity_Text_RivalVictory::
    .string "なんたって！\n"
    .string "おれは　てんさい　だからよ！$"

CeruleanCity_Text_GruntIntro::
    .string "Hej! Ven!\n"
    .string "Tohle není tvůj dvůr!\p"
    .string "…Cože?\n"
    .string "Já?\p"
    .string "Já jsem nevinný kolemjdoucí! Ty mi\n"
    .string "nevěříš?{PLAY_BGM}{MUS_ENCOUNTER_ROCKET}$"

CeruleanCity_Text_GruntDefeat::
    .string "GRUNT: Stop! Vzdávám se!\n"
    .string "Odejdu potichu!$"

CeruleanCity_Text_OkayIllReturnStolenTM::
    .string "…Dobře.\n"
    .string "Vrátím to TM, co jsem ukradl.$"

CeruleanCity_Text_RecoveredTM28FromGrunt::
    .string "{PLAYER} získává zpět od GRUNTA\n"
    .string "z TEAM ROCKET TM28.$"

CeruleanCity_Text_BetterGetMovingBye::
    .string "Radši už půjdu!\n"
    .string "Čau!$"

CeruleanCity_Text_MakeRoomForThisCantRun::
    .string "Udělej si na tohle místo! Nemůžu\n"
    .string "utéct, dokud ti to nedám!$"

CeruleanCity_Text_TrainerLifeIsToughIsntIt::
    .string "Ty jsi taky TRENÉR?\p"
    .string "Sbírání, souboje… Je to těžký\n"
    .string "život, co?$"

CeruleanCity_Text_YouCanCutDownSmallTrees::
    .string "Víš, že útokem CUT můžeš pokácet\n"
    .string "malé stromky?\p"
    .string "I ten stromek před obchodem se dá\n"
    .string "pokácet.\p"
    .string "Myslím ale, že se dá i obejít.$"

CeruleanCity_Text_IfSlowbroWasntThereCouldCutTree::
    .string "Kdyby tam nebyl ten SLOWBRO, šel\n"
    .string "by ten stromek pokácet útokem CUT.\p"
    .string "Tak by se dalo dostat na druhou\n"
    .string "stranu.\p"
    .string "Myslím ale, že se dá i obejít.$"

CeruleanCity_Text_PokemonEncyclopediaAmusing::
    .string "Ty děláš encyklopedii\n"
    .string "o POKéMONECH? To zní zábavně.$"

CeruleanCity_Text_PeopleHereWereRobbed::
    .string "Tady lidi někdo vykradl.\p"
    .string "Je jasné, že za tímhle odporným\n"
    .string "zločinem stojí TEAM ROCKET!\p"
    .string "I naše POLICIE má s ROCKETY\n"
    .string "potíže!$"

CeruleanCity_Text_SlowbroUseSonicboom::
    .string "Dobře! SLOWBRO!\n"
    .string "Použij SONICBOOM!$"

CeruleanCity_Text_SlowbroPayAttention::
    .string "No tak, SLOWBRO, dávej pozor!$"

CeruleanCity_Text_SlowbroPunch::
    .string "SLOWBRO, úder!$"

CeruleanCity_Text_NoYouBlewItAgain::
    .string "Ne!\n"
    .string "Zase jsi to zkazil!$"

CeruleanCity_Text_SlowbroWithdraw::
    .string "SLOWBRO, WITHDRAW!$"

CeruleanCity_Text_HardToControlMonsObedience::
    .string "Ne! To je špatně!\n"
    .string "Ovládat POKéMONY je tak těžké!\p"
    .string "Poslušnost tvých POKéMONŮ závisí\n"
    .string "na tvých schopnostech TRENÉRA.$"

CeruleanCity_Text_SlowbroTookSnooze::
    .string "SLOWBRO si zdřímnul…$"

CeruleanCity_Text_SlowbroLoafingAround::
    .string "SLOWBRO se fláká…$"

CeruleanCity_Text_SlowbroTurnedAway::
    .string "SLOWBRO se otočil zády…$"

CeruleanCity_Text_SlowbroIgnoredOrders::
    .string "SLOWBRO ignoruje rozkazy…$"

CeruleanCity_Text_WantBrightRedBicycle::
    .string "Chci zářivě červené kolo.\p"
    .string "Budu ho mít doma, aby se\n"
    .string "neušpinilo.$"

CeruleanCity_Text_ThisIsCeruleanCave::
    .string "Tohle je CERULEAN CAVE.\p"
    .string "Žijí tam strašně silní POKéMONI.\p"
    .string "Dovnitř smí jen opravdu výjimečný\n"
    .string "TRENÉR.\p"
    .string "V první řadě je potřeba mít sílu\n"
    .string "na to stát se ŠAMPIONEM POKéMON\l"
    .string "LEAGUE.\p"
    .string "A taky mít za sebou velký čin.$"

CeruleanCity_Text_CitySign::
    .string "CERULEAN CITY\n"
    .string "Město s tajemnou modrou aurou$"

CeruleanCity_Text_TrainerTipsHeldItems::
    .string "RADY PRO TRENÉRY\p"
    .string "POKéMONOVI můžeš dát podržet\n"
    .string "předmět.\p"
    .string "Některé předměty pak může POKéMON\n"
    .string "v souboji i použít.$"

CeruleanCity_Text_BikeShopSign::
