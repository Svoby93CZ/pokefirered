Text_MegaPunchTeach::
    .string "Úder burácející zuřivosti!\p"
    .string "Plný ničivé síly!\p"
    .string "Když jde do tuhého,\n"
    .string "MEGA PUNCH je nejlepší útok!\l"
    .string "Souhlasíš, že?\p"
    .string "Tak!\n"
    .string "Naučím ho tvého POKéMONA!$"

Text_MegaPunchDeclined::
    .string "Vrátíš se, až pochopíš, jakou cenu\n"
    .string "má MEGA PUNCH.$"

Text_MegaPunchWhichMon::
    .string "Dobře!\n"
    .string "Který POKéMON se ho naučí?$"

Text_MegaPunchTaught::
    .string "Teď jsme druhové na cestě úderu!\p"
    .string "Radši zmiz, než tě uvidí ten\n"
    .string "pomýlený blázen, co tamhle trénuje\l"
    .string "jen ty svoje hloupé kopy.$"

Text_MegaKickTeach::
    .string "Kop brutální zuřivosti!\p"
    .string "Plný ničivé síly!\p"
    .string "Když na to přijde,\n"
    .string "MEGA KICK je nejlepší útok!\l"
    .string "Nesouhlasíš?\p"
    .string "Dobře!\n"
    .string "Naučím ho tvého POKéMONA!$"

Text_MegaKickDeclined::
    .string "Připlazíš se zpátky, až pochopíš,\n"
    .string "jakou cenu má MEGA KICK.$"

Text_MegaKickWhichMon::
    .string "Tak jo!\n"
    .string "Který POKéMON se ho chce naučit?$"

Text_MegaKickTaught::
    .string "Teď jsme spřízněné duše na cestě\n"
    .string "kopu!\p"
    .string "Uteč, než tě uvidí ten zaslepený\n"
    .string "trouba, co tamhle trénuje jen\l"
    .string "obyčejné údery.$"

Route4_Text_PeopleLikeAndRespectBrock::
    .string "Páni, to je BOULDERBADGE!\n"
    .string "Ten máš od BROCKA, že jo?\p"
    .string "BROCK je super. Není jen silný.\n"
    .string "Lidi ho mají rádi a váží si ho.\p"
    .string "Chci být VŮDCE STADIONU jako on.$"
