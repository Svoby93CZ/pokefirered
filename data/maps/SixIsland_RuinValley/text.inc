    .string "Rád ti to řeknu.$"

SixIsland_RuinValley_Text_HectorPostBattle::
    .string "Dveře do zřícenin…\p"
    .string "Na vnější straně mají vyryté\n"
    .string "zvláštní vzory.\p"
    .string "Nevím ale, co znamenají.$"
