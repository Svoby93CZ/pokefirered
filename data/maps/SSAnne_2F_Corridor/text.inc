SSAnne_2F_Corridor_Text_ThisShipIsLuxuryLiner::
    .string "Tahle loď je luxusní parník pro\n"
    .string "TRENÉRY z celého světa!\p"
    .string "V každém přístavu pořádáme\n"
    .string "večírky s pozvanými TRENÉRY.$"

SSAnne_2F_Corridor_Text_RivalIntro::
    .string "{RIVAL}: Bonjour!\n"
    .string "{PLAYER}!\p"
    .string "To je ale náhoda, že tě tu vidím!\n"
    .string "{PLAYER}, opravdu tě pozvali?\p"
    .string "Tak jak ti jde POKéDEX?\p"
    .string "Já už mám chycených 40 druhů.\n"
    .string "Různé druhy jsou všude.\p"
    .string "Prolez travnaté oblasti a pořádně\n"
    .string "hledej.$"

SSAnne_2F_Corridor_Text_RivalDefeat::
    .string "Hmpf!\p"
    .string "Aspoň své POKéMONY vychováváš!$"

SSAnne_2F_Corridor_Text_RivalVictory::
    .string "{PLAYER}‥！\n"
    .string "ふなよい　してるのか！\p"
    .string "もっと　からだ\n"
    .string "きたえた　ほうが　いいぜ！$"

SSAnne_2F_Corridor_Text_RivalPostBattle::
    .string "{RIVAL}: Slyšel jsem, že je na\n"
    .string "palubě mistr útoku CUT.\p"
    .string "Ale byl to jen starý pán s mořskou\n"
    .string "nemocí!\p"
    .string "Samotný CUT je ale fakt užitečný.\n"
    .string "Jo, bude se hodit.\p"
    .string "Zajdi za ním taky.\n"
    .string "Čau!$"

