Route19_Text_RichardIntro::
    .string "Před plaváním se musím rozcvičit\n"
    .string "a zahřát.$"

Route19_Text_RichardDefeat::
    .string "Zahřátý!$"

Route19_Text_RichardPostBattle::
    .string "Díky, prcku!\n"
    .string "Už jsem připravený na plavání.$"

Route19_Text_ReeceIntro::
    .string "Počkej! Zpomal!\n"
    .string "Dostaneš infarkt!$"

Route19_Text_ReeceDefeat::
    .string "Uuh!\n"
    .string "To je zima!$"

Route19_Text_ReecePostBattle::
    .string "Pozor na TENTACOOL.\n"
    .string "Strašně bolestivě žahají.$"

Route19_Text_MatthewIntro::
    .string "Miluju plavání!\n"
    .string "A ty?$"

Route19_Text_MatthewDefeat::
    .string "Placák!$"

Route19_Text_MatthewPostBattle::
    .string "V plavání porazím i mořské\n"
    .string "POKéMONY.$"

Route19_Text_DouglasIntro::
    .string "Co je za obzorem?$"

Route19_Text_DouglasDefeat::
    .string "Blub!$"

Route19_Text_DouglasPostBattle::
    .string "Támhle vidím pár ostrovů!$"

Route19_Text_DavidIntro::
    .string "Zkoušel jsem se za POKéMONY\n"
    .string "potápět, ale nešlo to.$"

Route19_Text_DavidDefeat::
    .string "Pomoc!$"

Route19_Text_DavidPostBattle::
    .string "Na mořské POKéMONY se asi musí\n"
    .string "rybařit.$"

Route19_Text_TonyIntro::
    .string "Dívám se na moře, abych zapomněl\n"
    .string "na všechno zlé, co se stalo.$"

Route19_Text_TonyDefeat::
    .string "Uuh!\n"
    .string "Traumatizující!$"

Route19_Text_TonyPostBattle::
    .string "Dívám se na moře, abych zapomněl\n"
    .string "na tu zlou věc, co se stala!$"

Route19_Text_AnyaIntro::
    .string "Ách, na čem plaveš, to je úžasné!\n"
    .string "Dáš mi to, když vyhraju?$"

Route19_Text_AnyaDefeat::
    .string "Ach! Prohrála jsem!$"

Route19_Text_AnyaPostBattle::
    .string "K SEAFOAM ISLANDS je to ještě\n"
    .string "daleko…\p"
    .string "Chci zpátky do FUCHSIA…$"

Route19_Text_AliceIntro::
    .string "Plavání je skvělé!\n"
    .string "Spálení od slunce ne!$"

Route19_Text_AliceDefeat::
    .string "Šok!$"

Route19_Text_AlicePostBattle::
    .string "Můj přítel chtěl doplavat na\n"
    .string "SEAFOAM ISLANDS.$"

Route19_Text_AxleIntro::
    .string "Ahoj!\n"
    .string "Tyhle vody jsou zrádné!$"

Route19_Text_AxleDefeat::
    .string "Uuh!\n"
    .string "Nebezpečné!$"

Route19_Text_AxlePostBattle::
    .string "M-moje nohy! Chytla mě křeč!\n"
    .string "Blub, blub…$"

Route19_Text_ConnieIntro::
    .string "Plavala jsem sem s kamarády…\n"
    .string "Jsem unavená…$"

Route19_Text_ConnieDefeat::
    .string "Jsem vyčerpaná…$"

Route19_Text_ConniePostBattle::
    .string "Kdybych měla po moři jezdit na\n"
    .string "POKéMONOVI, chtěla bych LAPRAS.\p"
    .string "LAPRAS je tak velký, že bych na\n"
    .string "vodě určitě zůstala suchá.$"

Route19_Text_RouteSign::
    .string "SEA ROUTE 19\n"
    .string "FUCHSIA CITY - SEAFOAM ISLANDS$"

Route19_Text_LiaIntro::
    .string "LIA: Dohlížím na bráchu.\n"
    .string "Zrovna se stal TRENÉREM.$"

Route19_Text_LiaDefeat::
    .string "LIA: Takhle se s mým bráškou\n"
    .string "nezachází!$"

Route19_Text_LiaPostBattle::
    .string "LIA: Máš mladšího bratra?\p"
    .string "Doufám, že ho učíš všechno možné.$"

Route19_Text_LiaNotEnoughMons::
    .string "LIA: Chci bojovat spolu s bráškou.\p"
    .string "Nemáš dva POKéMONY?$"

Route19_Text_LucIntro::
    .string "LUC: Ségra mě naučila plavat\n"
    .string "a trénovat POKéMONY.$"

Route19_Text_LucDefeat::
    .string "LUC: Páni!\n"
    .string "Někdo silnější než moje ségra!$"

Route19_Text_LucPostBattle::
    .string "LUC: Moje ségra je silná a hodná.\n"
    .string "Podle mě je úžasná!$"

Route19_Text_LucNotEnoughMons::
    .string "LUC: Bez ségry s tebou bojovat\n"
    .string "nechci.\p"
    .string "Nemáš dva POKéMONY?$"
