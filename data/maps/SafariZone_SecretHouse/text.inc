SafariZone_SecretHouse_Text_CongratsYouveWon::
    .string "Á! Konečně!\p"
    .string "Jste první, kdo došel do SECRET\n"
    .string "HOUSE!\p"
    .string "Kampaň k velkému otevření jsem\n"
    .string "sice vyhlásil,\p"
    .string "ale začínal jsem se bát, že naši\n"
    .string "cenu nikdo nezíská.\p"
    .string "Gratuluji!\n"
    .string "Vyhráváte!$"

SafariZone_SecretHouse_Text_ReceivedHM03FromAttendant::
    .string "{PLAYER} dostává od obsluhy\n"
    .string "HM03!$"

SafariZone_SecretHouse_Text_ExplainSurf::
    .string "HM03 je SURF.\p"
    .string "S ním vás POKéMONI převezou přes\n"
    .string "vodu.\p"
    .string "A tohle HM není na jedno použití,\n"
    .string "takže ho můžete používat pořád\l"
    .string "dokola.\p"
    .string "Taková báječná cena, to je ale\n"
    .string "štěstí!$"

SafariZone_SecretHouse_Text_DontHaveRoomForPrize::
    .string "Na tuhle báječnou cenu nemáte\n"
    .string "místo!$"

