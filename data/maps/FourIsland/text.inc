FourIsland_Text_IslandSign::
    .string "FOUR ISLAND\n"
    .string "Floe, teplý a modrý ostrov$"

FourIsland_Text_LoreleiHasReturned::
    .string "LORELEI se vrátila.\p"
    .string "Nebyl pro ni život ve městě moc\n"
    .string "stresující?$"

FourIsland_Text_LoreleiMetLaprasAsChild::
    .string "LORELEI zase odjela.\p"
    .string "Ten LAPRAS, co má, je podle mě\n"
    .string "ten, kterého potkala jako dítě.\p"
    .string "Myslím, že ho chytila v ICEFALL\n"
    .string "CAVE.\p"
    .string "Možná je s ní ten POKéMON od té\n"
    .string "doby pořád.$"

FourIsland_Text_RivalAlreadyGotEggBeSmellingYa::
    .string "{RIVAL}: Hej!\n"
    .string "{PLAYER}!\p"
    .string "Co ty tady na SEVII ISLANDS\n"
    .string "děláš?\p"
    .string "Přestaň mě pořád napodobovat, jo?\p"
    .string "Každopádně už mám svoje POKéMON\n"
    .string "VEJCE, takže s tímhle ostrovem\l"
    .string "jsem hotový.\p"
    .string "Heh, vsadím se, že o POKéMON\n"
    .string "VEJCÍCH ani nevíš.\p"
    .string "Takhle NATIONAL POKéDEX nikdy\n"
    .string "nezaplníš.\p"
    .string "Mimochodem, na tomhle ostrově jsem\n"
    .string "viděl někoho, koho oba známe.\p"
    .string "Proč se tu nerozhlédneš, jestli tě\n"
    .string "to zajímá?\p"
    .string "Já nemám čas ztrácet čas.\p"
    .string "Zatím čau!$"

FourIsland_Text_LoreleiHasLotsOfStuffedDolls::
    .string "Á, jsem odhalená!\n"
    .string "Prosím, neříkej to LORELEI.\p"
    .string "Víš, že LORELEI má spoustu\n"
    .string "a spoustu plyšáků?\p"
    .string "Pokaždé, když se vrátí na FOUR\n"
    .string "ISLAND, její sbírka se rozroste!$"

FourIsland_Text_MadeSlushieUsingIcefallCaveIce::
    .string "Brr, zima!\p"
    .string "Udělal jsem si ledovou tříšť\n"
    .string "z ledu, který jsem nastrouhal\l"
    .string "v ICEFALL CAVE.\p"
    .string "Je studená a chutná!$"

FourIsland_Text_LoreleisHouse::
    .string "DŮM LORELEI$"

