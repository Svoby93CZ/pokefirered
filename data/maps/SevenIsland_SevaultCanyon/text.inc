SevenIsland_SevaultCanyon_Text_CyndyIntro::
    .string "Jsem ve skvělé formě!$"

SevenIsland_SevaultCanyon_Text_CyndyDefeat::
    .string "Cože?\n"
    .string "Něco tu nesedí…$"

SevenIsland_SevaultCanyon_Text_CyndyPostBattle::
    .string "Takhle možná budu muset TRAINER\n"
    .string "TOWER odložit…$"

SevenIsland_SevaultCanyon_Text_EvanIntro::
    .string "Nezáleží na tom, jestli máš zrovna\n"
    .string "nejsilnější POKéMONY…\p"
    .string "Nic to neznamená, když je neumíš\n"
    .string "správně používat!$"

SevenIsland_SevaultCanyon_Text_EvanDefeat::
    .string "Tohle ovládáš mistrovsky.$"

SevenIsland_SevaultCanyon_Text_EvanPostBattle::
    .string "Občas je vidíš, TRENÉRY s úžasnými\n"
    .string "POKéMONY, kteří nevědí, co s nimi.\p"
    .string "Než začnou TRENÉŘI trénovat\n"
    .string "POKéMONY, musí sami dospět.$"

SevenIsland_SevaultCanyon_Text_JacksonIntro::
    .string "Pracuju na ochraně přírody.\n"
    .string "A příroda chrání mě!$"

SevenIsland_SevaultCanyon_Text_JacksonDefeat::
    .string "Páni! Ty máš sílu!\n"
    .string "Nechceš mi dělat ochranku?$"

SevenIsland_SevaultCanyon_Text_JacksonPostBattle::
    .string "Z dálky mezi hvězdami je naše\n"
    .string "planeta jen kapka vody.\p"
    .string "Ale my tu kapku vody chceme\n"
    .string "chránit pro všechny.$"

SevenIsland_SevaultCanyon_Text_KatelynIntro::
    .string "Ty boty, co máš, jsou docela\n"
    .string "parádní.$"

SevenIsland_SevaultCanyon_Text_KatelynDefeat::
    .string "Na to, jak roztomile vypadáš, ti to\n"
    .string "fakt jde.$"

SevenIsland_SevaultCanyon_Text_KatelynPostBattle::
    .string "Ty parádní RUNNING SHOES ti\n"
    .string "koupila máma?\p"
    .string "Ta tě musí zbožňovat.$"

SevenIsland_SevaultCanyon_Text_LeroyIntro::
    .string "Vypadáš silně.\n"
    .string "Zabojuj si se mnou, prosím!$"

SevenIsland_SevaultCanyon_Text_LeroyDefeat::
    .string "Já to věděl!\n"
    .string "Máš takovou sílu, jak jsem čekal!$"

SevenIsland_SevaultCanyon_Text_LeroyPostBattle::
    .string "Tvůj styl boje mi dal spoustu\n"
    .string "užitečných dat.\p"
    .string "Moc díky!$"

SevenIsland_SevaultCanyon_Text_MichelleIntro::
    .string "Dostalo se mi nejlepšího možného\n"
    .string "vzdělání, abych byla takhle silná.\p"
    .string "Nechci prohrát s nikým!$"

SevenIsland_SevaultCanyon_Text_MichelleDefeat::
    .string "Děkuju. Prohrou s tebou jako bych\n"
    .string "se osvobodila.$"

SevenIsland_SevaultCanyon_Text_MichellePostBattle::
    .string "Z nějakého důvodu se rozzuřím\n"
    .string "kvůli každé maličkosti.\p"
    .string "Uklidním se hlubokým dýcháním.$"

SevenIsland_SevaultCanyon_Text_LexIntro::
    .string "LEX: Má drahá NYO, spolu můžeme\n"
    .string "vyhrát!$"

SevenIsland_SevaultCanyon_Text_LexDefeat::
    .string "LEX: Zřejmě jsem byl příliš\n"
    .string "neopatrný…$"

SevenIsland_SevaultCanyon_Text_LexPostBattle::
    .string "LEX: Myslím, že to byla pro NYU\n"
    .string "dobrá zkušenost.\p"
    .string "Máš mou vděčnost.$"

SevenIsland_SevaultCanyon_Text_LexNotEnoughMons::
    .string "LEX: Mohu tě požádat o souboj\n"
    .string "s námi oběma najednou?$"

SevenIsland_SevaultCanyon_Text_NyaIntro::
    .string "NYA: Budu se snažit, abych svého\n"
    .string "učitele LEXE nestáhla dolů!$"

SevenIsland_SevaultCanyon_Text_NyaDefeat::
    .string "NYA: Ach ne…\n"
    .string "Moc se omlouvám, já…$"

SevenIsland_SevaultCanyon_Text_NyaPostBattle::
    .string "NYA: Asi budu ještě potřebovat\n"
    .string "hodně zkušeností a výuky od LEXE…\p"
    .string "…Tak, LEXI, prosím, můžu s tebou\n"
    .string "takhle zůstat?$"

SevenIsland_SevaultCanyon_Text_NyaNotEnoughMons::
    .string "NYA: Promiň, ale můžeme bojovat\n"
    .string "stylem dva na dva?$"

SevenIsland_SevaultCanyon_Text_RouteSign::
    .string "SEVAULT CANYON\n"
    .string "DÁL JSOU TANOBY RUINS$"

SevenIsland_SevaultCanyon_Text_BrunoTrainedWithBrawly::
    .string "Trénovat o samotě rozhodně není\n"
    .string "špatné.\p"
    .string "Ale není špatné ani mířit na vrchol\n"
    .string "s partnerem.\p"
    .string "I BRUNO… Ten kdysi trénoval\n"
    .string "s chlapíkem jménem BRAWLY.$"
