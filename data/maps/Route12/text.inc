    .string "zlepší.\p"
    .string "V POKéMONECH mám sice prohráno,\n"
    .string "ale v rybaření mě nepředčíš.$"

Route12_Text_ElliotIntro::
    .string "Rybaření miluju, nechápej mě\n"
    .string "špatně.\p"
    .string "Ale bylo by fajn mít i víc práce.$"

Route12_Text_ElliotDefeat::
    .string "Není to snadné…$"

Route12_Text_ElliotPostBattle::
    .string "To nic.\n"
    .string "Prohry mě už netrápí.$"

Route12_Text_AndrewIntro::
    .string "Co bere?\p"
    .string "Nikdy nevíš, co chytíš!$"

Route12_Text_AndrewDefeat::
    .string "Utekla!$"

Route12_Text_AndrewPostBattle::
    .string "Cože, MAGIKARP?\p"
    .string "Ty chytám pořád, jasně.\n"
    .string "Ale jsou to teda slaboši.$"

Route12_Text_RouteSign::
    .string "ROUTE 12\n"
    .string "Na sever do LAVENDER$"

Route12_Text_SportfishingArea::
    .string "SPORTOVNÍ RYBOLOV$"

Route12_Text_JesIntro::
    .string "JES: Jestli vyhrajeme, požádám GIU\n"
    .string "o ruku.$"

Route12_Text_JesDefeat::
