    .string "POKéMONY vyvinout.\p"
    .string "Pak bych určitě vyhrál.$"

Route12_Text_LucaIntro::
    .string "Elektřina je moje specialita.\p"
    .string "O mořských POKéMONECH ale nevím\n"
    .string "vůbec nic.$"

