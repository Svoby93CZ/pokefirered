    .string "GIA: Hele, JESI…\p"
    .string "Jestli vyhrajeme, vezmu si tě!$"

Route12_Text_GiaDefeat::
    .string "GIA: Ale proč?$"

Route12_Text_GiaPostBattle::
    .string "GIA: JESI, ty trdlo!\n"
    .string "Tys to pokazil!$"

Route12_Text_GiaNotEnoughMons::
    .string "GIA: Bez svého JESE nesnesu\n"
    .string "bojovat!\p"
    .string "Nemáš ještě jednoho POKéMONA?$"
