    .string "mořské POKéMONY platí elektřina.$"

Route12_Text_HankIntro::
    .string "BLÁZEN DO RYBAŘENÍ proti POKéMON\n"
    .string "DĚCKU!$"

Route12_Text_HankDefeat::
    .string "To bylo trochu moc!$"

Route12_Text_HankPostBattle::
