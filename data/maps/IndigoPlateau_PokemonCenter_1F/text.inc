IndigoPlateau_PokemonCenter_1F_Text_GymGuyAdvice::
    .string "Čau!\n"
    .string "Ty budoucí hvězdo!\p"
    .string "V POKéMON LEAGUE se utkáš se všemi\n"
    .string "z ELITE FOUR hned po sobě.\p"
    .string "Když prohraješ, musíš začít úplně\n"
    .string "od začátku!\p"
    .string "Teď to přijde!\n"
    .string "Do toho!$"

IndigoPlateau_PokemonCenter_1F_Text_FaceEliteFourGoodLuck::
    .string "Odsud se utkáš s ELITE FOUR\n"
    .string "jedním po druhém.\p"
    .string "Když vyhraješ, otevřou se dveře\n"
    .string "k dalšímu TRENÉROVI. Hodně štěstí!$"

IndigoPlateau_PokemonCenter_1F_Text_LoreleiIsAbsentClosedForTimeBeing::
    .string "Je mi moc líto, ale cesta sem byla\n"
    .string "zbytečná.\p"
    .string "LORELEI z ELITE FOUR totiž není\n"
    .string "přítomna.\p"
    .string "POKéMON LEAGUE je proto zatím\n"
    .string "zavřená.$"

IndigoPlateau_PokemonCenter_1F_Text_AgathaWhuppedUs::
    .string "GHOST POKéMONI AGATHY jsou děsivě\n"
    .string "silní.\p"
    .string "Vzal jsem své FIGHTING POKéMONY\n"
    .string "a vytrénoval je na maximum.\p"
    .string "Šel jsem na AGATHU docela\n"
    .string "sebevědomě, ale rozdrtila nás.\p"
    .string "Ta stará paní má taky hrozně\n"
    .string "krátké nervy.\p"
    .string "Tu děsivou paní rozkřičí úplná\n"
    .string "maličkost.$"

IndigoPlateau_PokemonCenter_1F_Text_LancesCousinGymLeaderFarAway::
    .string "Možná je být členem ELITE FOUR\n"
    .string "v krvi.\p"
    .string "Co jsem slyšel, LANCE má\n"
    .string "sestřenici, která je VŮDKYNÍ\l"
    .string "STADIONU někde daleko.$"

