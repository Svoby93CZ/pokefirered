ViridianCity_Text_CanCarryMonsAnywhere::
    .string "Ty POKé BALLY u pasu! Ty máš\n"
    .string "POKéMONY, že jo?\p"
    .string "Je skvělé, že můžeš POKéMONY nosit\n"
    .string "a používat kdykoli a kdekoli.$"

ViridianCity_Text_GymClosedWonderWhoLeaderIs::
    .string "Tenhle POKéMON STADION je pořád\n"
    .string "zavřený.\p"
    .string "Kdo je asi jeho VŮDCE?$"

ViridianCity_Text_ViridiansGymLeaderReturned::
    .string "VŮDCE STADIONU VIRIDIAN se\n"
    .string "vrátil!$"

ViridianCity_Text_WantToKnowAboutCaterpillarMons::
    .string "Chceš vědět o dvou druzích\n"
    .string "housenkových POKéMONŮ?$"

ViridianCity_Text_OhOkayThen::
    .string "Aha, tak dobře!$"

ViridianCity_Text_ExplainCaterpieWeedle::
    .string "CATERPIE není jedovatý, ale\n"
    .string "WEEDLE ano.\p"
    .string "Dávej pozor, ať tvé POKéMONY\n"
    .string "nebodne WEEDLE útokem POISON\l"
    .string "STING.$"

ViridianCity_Text_GrandpaHasntHadCoffeeYet::
    .string "Ach, dědo!\n"
    .string "Nebuď tak zlý!\p"
    .string "Moc se omlouvám.\n"
    .string "Ještě neměl kafe.$"

ViridianCity_Text_GoShoppingInPewterOccasionally::
    .string "Občas jezdím nakupovat do PEWTER\n"
    .string "CITY.\p"
    .string "Cestou musím projít klikatou\n"
    .string "stezkou ve VIRIDIAN FOREST.$"

ViridianCity_Text_ThisIsPrivateProperty::
    .string "Tudy tě rozhodně nepustím!\p"
    .string "Tohle je soukromý pozemek!$"

ViridianCity_Text_ShowYouHowToCatchMons::
    .string "Tak, kafe mám vypité, a to je\n"
    .string "přesně to, co potřebuju, abych se\l"
    .string "rozjel!\p"
    .string "Hm?\n"
    .string "Co je to za červenou krabičku?\p"
    .string "Aha, takže sbíráš údaje do\n"
    .string "POKéDEXU.\p"
    .string "Tak ti dám jednu radu.\p"
    .string "Kdykoli chytíš POKéMONA, POKéDEX\n"
    .string "si automaticky doplní údaje.\p"
    .string "…Ty nevíš, jak se chytá POKéMON?\p"
    .string "Tak to ti to radši ukážu!$"

ViridianCity_Text_ThatWasEducationalTakeThis::
    .string "Tak! A teď mi řekni, nebylo to\n"
    .string "poučné?\p"
    .string "A tady, vezmi si ještě tohle.$"

ViridianCity_Text_WatchThatToLearnBasics::
    .string "Když něčemu nebudeš rozumět,\n"
    .string "podívej se na tohle.\p"
    .string "Naučí tě to základy toho, jak být\n"
    .string "POKéMON TRENÉREM.$"

ViridianCity_Text_WeakenMonsFirstToCatch::
    .string "Tak, kafe mám vypité, a to je\n"
    .string "přesně to, co potřebuju, abych se\l"
    .string "rozjel!\p"
    .string "Ale udělal jsem ho moc silné.\n"
    .string "Bolí mě z něj hlava…\p"
    .string "Mimochodem, plníš si POKéDEX?\p"
    .string "Zezačátku se soustřeď na oslabení\n"
    .string "POKéMONA, než ho zkusíš chytit.$"

ViridianCity_Text_HowsTeachyTVHelping::
    .string "Tak, kafe mám vypité, a to je\n"
    .string "přesně to, co potřebuju, abych se\l"
    .string "rozjel!\p"
    .string "Ale udělal jsem ho moc silné.\n"
    .string "Bolí mě z něj hlava…\p"
    .string "Mimochodem, pomáhá ti moje stará\n"
    .string "TEACHY TV?$"

ViridianCity_Text_MyGrandsonOnTheShow::
