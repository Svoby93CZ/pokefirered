FiveIsland_ResortGorgeous_Text_DaisyIntro::
    .string "Těmito rukama si vytvořím\n"
    .string "vítězství!$"

FiveIsland_ResortGorgeous_Text_DaisyDefeat::
    .string "Ta hanba…\n"
    .string "Jsem rudá až za ušima…$"

FiveIsland_ResortGorgeous_Text_DaisyPostBattle::
    .string "Ajaj, tuby s barvami se mi\n"
    .string "rozkutálely všude!$"

FiveIsland_ResortGorgeous_Text_CelinaIntro::
    .string "Promiň!\n"
    .string "Snažím se malovat.\l"
    .string "Prosím, nelez mi do zorného pole!$"

FiveIsland_ResortGorgeous_Text_CelinaDefeat::
    .string "Tahle prohra…\n"
    .string "Jako bych celá zbělela…$"

FiveIsland_ResortGorgeous_Text_CelinaPostBattle::
    .string "GILLIAN?\n"
    .string "Nakloň prosím trochu hlavu…\l"
    .string "Tak! Přesně tenhle výraz chci!$"

FiveIsland_ResortGorgeous_Text_RaynaIntro::
    .string "Hmm…\n"
    .string "Ten úhel, ten není úplně ono…$"

FiveIsland_ResortGorgeous_Text_RaynaDefeat::
    .string "Ach…\n"
    .string "Mám v duši samou modř…$"

FiveIsland_ResortGorgeous_Text_RaynaPostBattle::
    .string "Nebe a moře…\n"
    .string "Jsou tak vrtkavé.\p"
    .string "Jejich měnící se výrazy se těžko\n"
    .string "zachycují.$"

FiveIsland_ResortGorgeous_Text_JackiIntro::
    .string "Navštěvuji sídlo své přítelkyně,\n"
    .string "když to musíš vědět.$"

FiveIsland_ResortGorgeous_Text_JackiDefeat::
    .string "Páni, taková síla.$"

FiveIsland_ResortGorgeous_Text_JackiPostBattle::
    .string "Pokládám za příjemné nenuceně\n"
    .string "bojovat v jemném mořském vánku.$"

FiveIsland_ResortGorgeous_Text_GillianIntro::
    .string "Uvažuji, že si nechám postavit\n"
    .string "bazén speciálně pro POKéMONY.$"

FiveIsland_ResortGorgeous_Text_GillianDefeat::
    .string "Ach, proboha!$"

FiveIsland_ResortGorgeous_Text_GillianPostBattle::
    .string "Bazén by byl pěkný, ale musím\n"
    .string "říct, že zimní zahrada by mohla\l"
    .string "být nádherná.$"

FiveIsland_ResortGorgeous_Text_DestinIntro::
    .string "Umím dobře běhat.\n"
    .string "Jsem fakt rychlý!$"

FiveIsland_ResortGorgeous_Text_DestinDefeat::
    .string "Jejda!\n"
    .string "Uspěchal jsem to!$"

FiveIsland_ResortGorgeous_Text_DestinPostBattle::
    .string "Když běžím s větrem, mám pocit, že\n"
    .string "bych mohl letět!$"

FiveIsland_ResortGorgeous_Text_TobyIntro::
    .string "Řeknu ti, zdejší mořský život\n"
    .string "v tomhle letovisku mi svědčí.$"

FiveIsland_ResortGorgeous_Text_TobyDefeat::
    .string "To je šok!\n"
    .string "To si děláš legraci.$"

FiveIsland_ResortGorgeous_Text_TobyPostBattle::
    .string "Brát to takhle vážně…\n"
    .string "Jak nesmyslné.$"

FiveIsland_ResortGorgeous_Text_SelphyThanksYouMayGoNow::
    .string "SELPHY: Děkuji.\p"
    .string "Teď můžeš jít.$"

FiveIsland_ResortGorgeous_Text_SelphysHouse::
    .string "DŮM SELPHY$"

