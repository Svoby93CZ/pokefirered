TwoIsland_Text_DangerFastCurrent::
    .string "NEBEZPEČÍ! RYCHLÝ PROUD!\n"
    .string "Rybaření a surfování zakázáno!$"

TwoIsland_Text_WelcomeToShopMerchandiseLimited::
    .string "Á!\n"
    .string "Dobrý den, vítejte v mém obchodě!\p"
    .string "Otevřeli jsme teprve nedávno.\p"
    .string "Zboží máme zatím málo, ale\n"
    .string "doufám, že vám poslouží.$"

TwoIsland_Text_AddedMerchandiseForLostelle::
    .string "Ani nevíte, jak jsem vám vděčný za\n"
    .string "záchranu LOSTELLE.\p"
    .string "Díky vašemu činu změnili lidé\n"
    .string "z THREE ISLAND názor na lidi\l"
    .string "z KANTA.\p"
    .string "A já jsem totiž z KANTA.\p"
    .string "Lidé z THREE ISLAND mi pomohli\n"
    .string "rozšířit zboží.$"

TwoIsland_Text_HopeYouGiveItYourBest::
    .string "Dobrý den! Dávám do toho všechno.\n"
    .string "Doufám, že vy taky, {PLAYER}.$"

TwoIsland_Text_BringingItemsFromDistantLands::
    .string "Á, dobrý den, {PLAYER}!\n"
    .string "Vítejte!\p"
    .string "Začal jsem dovážet zboží ze\n"
    .string "vzdálených zemí.\p"
    .string "Mám tu i nějaké vzácné předměty.\n"
    .string "Podívejte se!$"

TwoIsland_Text_FellowMovedFromCeladonCity::
    .string "Tamten chlapík se sem přistěhoval\n"
    .string "z CELADON CITY.\p"
    .string "S mladším bratrem si tu otevřel\n"
    .string "obchod.\p"
    .string "Člověk se musí ptát, jestli věděl,\n"
    .string "do čeho jde.$"

TwoIsland_Text_ShopkeepersBrotherWorksGameCorner::
    .string "Bratr majitele obchodu vzal práci\n"
    .string "v GAME CORNER.\p"
    .string "Snaží se dát dohromady peníze,\n"
    .string "aby mohli koupit víc zboží.$"

TwoIsland_Text_BrunoCameToIslandWhileBack::
    .string "Poslouchej, poslouchej.\n"
    .string "Víš to?\p"
    .string "Nedávno sem na ostrov přijel\n"
    .string "slavný TRENÉR.\p"
    .string "Je to jeden z ELITE FOUR.\n"
    .string "Jmenuje se BRUNO.\p"
    .string "Odešel zklamaný, když zjistil, že\n"
    .string "tu mají vyprodané RAGE CANDYBAR.$"

TwoIsland_Text_BuyRareItemsHere::
    .string "Náročný TRENÉR ví, že vzácné\n"
    .string "předměty se kupují tady!$"

TwoIsland_Text_OldWomanLivesOutOnCape::
    .string "Na mysu žije v chaloupce jedna\n"
    .string "stará paní.\p"
    .string "Pozorně si prohlíží POKéMONY.\n"
    .string "Je to trochu znepokojivé.$"

TwoIsland_Text_HaveYouTriedJumpingGame::
    .string "Boing! Boing!\n"
    .string "Znáš tu skákací hru?\p"
    .string "POKéMONI, které můžeš přihlásit…\n"
    .string "Boing!\p"
    .string "Někteří dělají boing!\p"
    .string "A někteří booooooing!\p"
    .string "Víš o tom?\n"
