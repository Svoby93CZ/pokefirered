OneIsland_Text_BillLetsGoSeeCelio::
    .string "BILL: Jsme tady!\n"
    .string "Tohle je ONE ISLAND.\p"
    .string "Je tu kolem několik ostrovů a tohle\n"
    .string "je jeden z nich.\p"
    .string "Loď pro mě poslal můj kamarád\n"
    .string "CELIO.\p"
    .string "Stará se tu úplně sám o ostrovní\n"
    .string "síť PC.\p"
    .string "…Proč ti to vlastně teď vykládám?\n"
    .string "Pojďme rovnou za CELIEM!$"

Text_WhereDoYouWantToSail::
    .string "Ahoj!\n"
    .string "Kam chceš plout?$"

OneIsland_Text_LuckyToHaveCelioHere::
    .string "Jsme tu na ostrově uprostřed\n"
    .string "ničeho.\p"
    .string "Máme štěstí, že tu máme tak\n"
    .string "řádného mladého muže, jako je\l"
    .string "CELIO.\p"
    .string "Moje vnučka byla celá bez sebe\n"
    .string "z CELIOVA kamaráda.\p"
    .string "Prý nějaký slavný POKéMANIAK?\p"
    .string "Nevím, co to znamená, ale CELIO\n"
    .string "je pašák!$"

OneIsland_Text_HavePCLinkageWithKanto::
    .string "Moje vnučka byla celá bez sebe\n"
    .string "z nového objevu.\p"
    .string "Prý teď máme propojení PC s lidmi\n"
    .string "v KANTU.\p"
    .string "Nevím, co to znamená, ale CELIO\n"
    .string "je pašák!$"

OneIsland_Text_HavePCLinkageWithHoenn::
    .string "Moje vnučka byla celá bez sebe\n"
    .string "z nového objevu.\p"
    .string "Prý konečně máme propojení PC\n"
    .string "s lidmi v HOENNU.\p"
    .string "Nevím, co to znamená, ale CELIO\n"
    .string "je pašák.\p"
    .string "Byl by z něj skvělý manžel pro\n"
    .string "moji vnučku!$"

