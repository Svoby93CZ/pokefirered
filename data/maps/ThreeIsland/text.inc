ThreeIsland_Text_IslandSign::
    .string "THREE ISLAND\n"
    .string "Kin, ostrov rodinných pout$"

ThreeIsland_Text_IslandBelongsToUs::
    .string "Jůchú!\p"
    .string "Ode dneška tenhle ostrov patří\n"
    .string "nám!$"

ThreeIsland_Text_GoBackToKanto::
    .string "Nepotřebujeme, abyste sem tahali\n"
    .string "svůj hluk a potíže!\p"
    .string "Žádáme vás, abyste se vrátili do\n"
    .string "KANTA!$"

ThreeIsland_Text_BossIsOnHisWay::
    .string "Hej, běž brečet jinam.\n"
    .string "Náš šéf je na cestě.\p"
    .string "Až dorazí, předvedeme vám\n"
    .string "motoshow, na kterou jen tak\l"
    .string "nezapomenete!$"

ThreeIsland_Text_GetOffIslandNow::
    .string "C-cože!? To v žádném případě!\n"
    .string "Okamžitě zmizte z ostrova!$"

ThreeIsland_Text_WhosGonnaMakeMe::
    .string "A kdo mě donutí?$"

ThreeIsland_Text_AreYouBossGoBackToKanto::
    .string "Ty jsi ten šéf?\n"
    .string "Okamžitě se vrať do KANTA!$"

ThreeIsland_Text_JustGotHerePal::
    .string "Cože?\p"
    .string "Zrovna jsem dorazil, kámo.\p"
    .string "Co je to za nepřátelský přístup?\n"
    .string "To je od vás pěkně studené!$"

ThreeIsland_Text_FollowersRaisingHavoc::
    .string "Tvoje banda tady na motorkách\n"
    .string "řádí.\p"
    .string "Máš vůbec ponětí, kolik nám tu na\n"
    .string "ostrově způsobili potíží?$"

ThreeIsland_Text_OughtToBeThankingUs::
    .string "Ne, kámo, to vůbec nechápu.\p"
    .string "Podívej se na tohle místo.\n"
    .string "Co tu děláte pro zábavu?\p"
    .string "Měli byste nám děkovat, že jsme tu\n"
    .string "ospalou vesnici oživili.\p"
    .string "Ale jestli na tom trváte, můžete\n"
    .string "nás zkusit vyhnat.$"

ThreeIsland_Text_YouCowardsToughInPack::
    .string "Grr… Vy zbabělci…\n"
    .string "Ve smečce jste silní…$"

ThreeIsland_Text_WannaMakeSomethingOfYourStaring::
    .string "Ty, na co zíráš?\n"
    .string "Nevíš, že to je nezdvořilé?\p"
    .string "Chceš si něco začít, nebo co?$"

ThreeIsland_Text_ThatsSmart::
    .string "To je chytré.\n"
    .string "Drž se od toho dál.$"

ThreeIsland_Text_Biker1Intro::
    .string "Heh, máš kuráž, to se mi líbí.\n"
    .string "Přijdeš u mě o peníze, ale…$"

ThreeIsland_Text_Biker1Defeat::
    .string "Co…\n"
    .string "Co je to za děcko?!$"

ThreeIsland_Text_Biker1PostBattle::
    .string "Ach jo…\n"
    .string "Opovaž se smát!$"

ThreeIsland_Text_Biker2Intro::
    .string "Nejsi z KANTA?\n"
    .string "Tvoje místo je na naší straně!$"

ThreeIsland_Text_Biker2Defeat::
    .string "Přestaň blbnout!$"

ThreeIsland_Text_Biker2PostBattle::
    .string "Co tě to popadlo, takhle se\n"
    .string "rozčilovat?\p"
    .string "To fakt není cool, kámo!$"

ThreeIsland_Text_Biker3Intro::
    .string "Pozvali jsme sem šéfa, a ty to\n"
    .string "musíš pokazit!\p"
    .string "Kvůli tobě jsme za blbce, kámo!$"

ThreeIsland_Text_Biker3Defeat::
    .string "… … …   … … …$"

ThreeIsland_Text_Biker3PostBattle::
    .string "Šéfe, říkám ti, s tímhle děckem\n"
    .string "musíš něco udělat!$"

ThreeIsland_Text_PaxtonIntro::
    .string "Sleduju tě a řekl bych, že už\n"
    .string "toho bylo dost.\p"
    .string "Co jsi zač, patříš k nim nebo co?\p"
    .string "Tak to asi budeš bojovat se mnou\n"
    .string "místo nich.$"

ThreeIsland_Text_PaxtonDefeat::
    .string "Dobře, dost!\n"
    .string "Odejdeme, jak jste chtěli!\p"
    .string "Rádi už tenhle nudný ostrov\n"
    .string "neuvidíme!$"

ThreeIsland_Text_PaxtonPostBattle::
    .string "Hmpf! Jo, jen se dál stýkej\n"
    .string "s těmihle venkovany!$"

ThreeIsland_Text_ThankYouOhYourMonGotHurt::
    .string "Děkuju! Ti grázlové nedělali nic\n"
    .string "jiného než potíže.\p"
    .string "Á, podívej, tvoji POKéMONI se\n"
    .string "kvůli mně zranili.$"

ThreeIsland_Text_GivenFullRestore::
    .string "{PLAYER} dostává\n"
    .string "FULL RESTORE.$"

ThreeIsland_Text_OhYourBagIsFull::
    .string "Á?\n"
    .string "Tvůj BATOH je plný.$"

ThreeIsland_Text_YouveGotImpressiveMons::
    .string "Máš s sebou opravdu působivé\n"
    .string "POKéMONY.$"

ThreeIsland_Text_LostelleWentOffTowardsBondBridge::
    .string "Bylo by skvělé, kdyby tu bydlel\n"
    .string "někdo tak silný jako ty.\p"
    .string "Doufám, že tu aspoň chvíli\n"
    .string "zůstaneš.\p"
    .string "…Prosím?\n"
    .string "Hledáš LOSTELLE?\p"
    .string "LOSTELLE před chvílí odešla\n"
    .string "směrem k BOND BRIDGE.$"

ThreeIsland_Text_WouldntWantToSeeBikersHereAgain::
    .string "THREE ISLAND je vlastně\n"
    .string "nejlidnatější z místních ostrovů.\p"
    .string "Přesto by tu mohlo být trochu\n"
    .string "živěji.\p"
    .string "Ale grázly jako ti MOTORKÁŘI tu už\n"
    .string "vidět nechci.$"

ThreeIsland_Text_WhenDodouEvolvesGoingToPlayGame::
    .string "Budu trénovat svého DODUO v BERRY\n"
    .string "FOREST.\p"
    .string "Až se vyvine, půjdu si zahrát hru\n"
    .string "na TWO ISLAND.$"

ThreeIsland_Text_Doduo::
    .string "DODUO: Gigiih!$"

