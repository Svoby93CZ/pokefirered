SevenIsland_TanobyRuins_Text_BrandonIntro::
    .string "Víš něco o téhle kamenné komnatě?$"

SevenIsland_TanobyRuins_Text_BrandonDefeat::
    .string "To bylo zbytečné.\n"
    .string "Tak hrubě to být nemuselo.$"

SevenIsland_TanobyRuins_Text_BrandonPostBattle::
    .string "TANOBY RUINS jsou staré nejméně 1\n"
    .string "500 let.\p"
    .string "Ale proč byly vůbec postaveny, je\n"
    .string "záhadou.$"

SevenIsland_TanobyRuins_Text_BenjaminIntro::
    .string "Prý tu uvnitř spí mystický POKéMON.$"

SevenIsland_TanobyRuins_Text_BenjaminDefeat::
    .string "V soubojích moc dobrý nejsem.$"

SevenIsland_TanobyRuins_Text_BenjaminPostBattle::
    .string "Slyšel jsem, že existují další\n"
    .string "podobné zříceniny.\p"
    .string "Mohla by to být místa odpočinku\n"
    .string "dalších mystických POKéMONŮ?$"

SevenIsland_TanobyRuins_Text_EdnaIntro::
    .string "CLIFFORD mě učí malovat.$"

SevenIsland_TanobyRuins_Text_EdnaDefeat::
    .string "Za ten hluk tu můžeme mít potíže.$"

SevenIsland_TanobyRuins_Text_EdnaPostBattle::
    .string "Říkala jsem, že chci malovat\n"
    .string "starou budovu.\p"
    .string "Tak mě CLIFFORD vzal sem.$"

SevenIsland_TanobyRuins_Text_CliffordIntro::
    .string "Dnes jsme kromě lekce přišli i na\n"
    .string "prohlídku komnaty.$"

SevenIsland_TanobyRuins_Text_CliffordDefeat::
    .string "Páni, jak mimořádné.$"

SevenIsland_TanobyRuins_Text_CliffordPostBattle::
    .string "Á, takže zkoumáš POKéMONY na\n"
    .string "vlastní pěst…\p"
    .string "Ano, to je opravdu mimořádné.$"
