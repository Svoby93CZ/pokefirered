RockTunnel_B1F_Text_SofiaIntro::
    .string "Víš, jak se v horách neztratit?\p"
    .string "Můžeš lámat větvičky a značit si\n"
    .string "jimi cestu.$"

RockTunnel_B1F_Text_SofiaDefeat::
    .string "Ach!\n"
    .string "Snažila jsem se, jak to šlo!$"

RockTunnel_B1F_Text_SofiaPostBattle::
    .string "Chci domů!$"

RockTunnel_B1F_Text_DudleyIntro::
    .string "Chachacha!\n"
    .string "Překonáš mou sílu?$"

RockTunnel_B1F_Text_DudleyDefeat::
    .string "Jejda!\n"
    .string "Na tebe mé svaly nestačí!$"

RockTunnel_B1F_Text_DudleyPostBattle::
    .string "Sázím na sílu, protože nesnáším\n"
    .string "přemýšlení.$"

RockTunnel_B1F_Text_CooperIntro::
    .string "Ty máš POKéDEX?\n"
    .string "Taky ho chci.$"

RockTunnel_B1F_Text_CooperDefeat::
    .string "Sakra!\n"
    .string "Tak strašně ti závidím!$"

RockTunnel_B1F_Text_CooperPostBattle::
    .string "Až POKéDEX doplníš, dáš mi ho?$"

RockTunnel_B1F_Text_SteveIntro::
    .string "Ehm… Znáš POKéMON cosplay?$"

RockTunnel_B1F_Text_SteveDefeat::
    .string "No, tak to bychom měli.$"

RockTunnel_B1F_Text_StevePostBattle::
    .string "POKéMON cosplay znamená převlékat\n"
    .string "se pro zábavu za POKéMONY.\p"
    .string "Oblíbený je CLEFAIRY.$"

RockTunnel_B1F_Text_AllenIntro::
    .string "Z mých POKéMONÍCH technik se\n"
    .string "rozbrečíš!$"

RockTunnel_B1F_Text_AllenDefeat::
    .string "Vzdávám se!\n"
    .string "Tvoje technika je lepší!$"

RockTunnel_B1F_Text_AllenPostBattle::
    .string "V horách často najdeš POKéMONY\n"
    .string "typu ROCK.$"

RockTunnel_B1F_Text_MarthaIntro::
    .string "Moc často sem nechodím, ale\n"
    .string "s tebou si zabojuju.$"

RockTunnel_B1F_Text_MarthaDefeat::
    .string "Ach!\n"
    .string "Prohrála jsem!$"

RockTunnel_B1F_Text_MarthaPostBattle::
    .string "Mám ráda malinké POKéMONY.\n"
    .string "Ti velcí jsou moc strašidelní!$"

RockTunnel_B1F_Text_EricIntro::
    .string "Ukaž, co v tobě je!$"

RockTunnel_B1F_Text_EricDefeat::
    .string "Vystřílel jsem se!$"

RockTunnel_B1F_Text_EricPostBattle::
    .string "Vycvičím své POKéMONY, aby\n"
    .string "porazili ty tvoje, prcku.$"

RockTunnel_B1F_Text_WinstonIntro::
    .string "Doma kreslím obrázky POKéMONŮ.$"

RockTunnel_B1F_Text_WinstonDefeat::
    .string "Uf…\n"
    .string "Jsem vyčerpaný…$"

RockTunnel_B1F_Text_WinstonPostBattle::
    .string "Jsem umělec, ne bojovník.\n"
    .string "Půjdu domů kreslit.$"

