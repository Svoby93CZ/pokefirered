CinnabarIsland_Text_DoorIsLocked::
    .string "Dveře jsou zamčené…$"

CinnabarIsland_Text_BlaineLivedHereSinceBeforeLab::
    .string "BLAINE ze STADIONU na CINNABAR\n"
    .string "je pěkný podivín.\p"
    .string "Žije na ostrově už dávno předtím,\n"
    .string "než tu postavili POKéMON LAB.$"

CinnabarIsland_Text_ScientistsExperimentInMansion::
    .string "Vědci dělají pokusy ve vyhořelé\n"
    .string "budově.\p"
    .string "Víš, v té, které se říká POKéMON\n"
    .string "MANSION.$"

CinnabarIsland_Text_IslandSign::
    .string "CINNABAR ISLAND\n"
    .string "Ohnivé město spalující touhy$"

CinnabarIsland_Text_PokemonLab::
    .string "POKéMON LAB$"

CinnabarIsland_Text_GymSign::
    .string "POKéMON STADION CINNABAR ISLAND\n"
    .string "VŮDCE: BLAINE\l"
    .string "Horkokrevný mistr kvízů!$"

CinnabarIsland_Text_HeyIfItIsntPlayer::
    .string "Cože?\n"
    .string "Hej, vždyť je to {PLAYER}!$"

CinnabarIsland_Text_ComeWithMeToOneIsland::
    .string "Koukej, to jsem já, BILL.\n"
    .string "Dlouho jsme se neviděli!\p"
    .string "Doufám, že pořád používáš můj\n"
    .string "systém PC.\p"
    .string "Poslyš, když už jsme se tu potkali,\n"
    .string "co takhle strávit chvíli spolu?\p"
    .string "Daleko na jihu je takový malý\n"
    .string "ostrov, jmenuje se ONE ISLAND.\p"
    .string "Pozval mě tam kamarád, tak se tam\n"
    .string "právě chystám.\p"
    .string "Co ty na to?\n"
    .string "Půjdeš se mnou?$"

CinnabarIsland_Text_AllRightLetsGo::
    .string "Tak dobře.\n"
    .string "Jdeme na to!$"

CinnabarIsland_Text_IllBeWaitingInPokeCenter::
    .string "Cože, nemáš čas?\p"
    .string "No dobře.\n"
    .string "Loď stejně ještě nepřijela.\p"
    .string "Budu čekat tamhle v POKéMON\n"
    .string "CENTER.\p"
    .string "Až tu všechno vyřídíš, přijď za\n"
    .string "mnou.$"

CinnabarIsland_Text_MyPalsBoatArrived::
    .string "Vypadá to, že kamarádova loď už\n"
    .string "taky připlula.\p"
    .string "Poslal ji sem na CINNABAR schválně\n"
    .string "pro mě.$"

CinnabarIsland_Text_IfYouHaveTriPassYouCanGoAgain::
    .string "Hej, to byla ale dlouhá plavba,\n"
    .string "co?\p"
    .string "Mému kámošovi CELIOVI se tvoje\n"
    .string "společnost zřejmě líbila.\p"
    .string "Určitě by tě rád zase viděl.\p"
    .string "Když máš TRI-PASS, můžeš tam\n"
    .string "kdykoli jet trajektem z VERMILION\l"
    .string "PORT.\p"
    .string "Tak jo, díky za společnost!$"

