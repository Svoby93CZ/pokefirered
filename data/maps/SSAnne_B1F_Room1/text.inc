SSAnne_B1F_Room1_Text_PhillipIntro::
    .string "Jestli prohraješ, půjdeš přes\n"
    .string "palubu!$"

SSAnne_B1F_Room1_Text_PhillipDefeat::
    .string "Argh!\n"
    .string "Porazilo mě děcko!$"

SSAnne_B1F_Room1_Text_PhillipPostBattle::
    .string "Když jsme na moři, občas kolem\n"
    .string "proplují medúzoví POKéMONI.$"

SSAnne_B1F_Room1_Text_BarnyIntro::
    .string "Zdravím!\p"
    .string "Nevím, jestli jsi od moře, nebo\n"
    .string "z hor, ale zastav se na kus řeči.\p"
    .string "Všichni moji POKéMONI jsou z moře.$"

SSAnne_B1F_Room1_Text_BarnyDefeat::
    .string "Sakra!\n"
    .string "Ten mi utekl!$"

SSAnne_B1F_Room1_Text_BarnyPostBattle::
    .string "A to jsem z tebe chtěl udělat svou\n"
    .string "pravou ruku!$"

