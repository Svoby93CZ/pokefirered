PokemonJournal_Text_SpecialFeatureBrock::
	.string "POKéMON JOURNAL\p"
	.string "Speciál: VŮDCE STADIONU\n"
	.string "v PEWTER BROCK!\p"
	.string "BROCK se prý směje jen zřídka, ale\n"
	.string "když začne, nemůže přestat.$"

PokemonJournal_Text_SpecialFeatureMisty::
	.string "POKéMON JOURNAL\p"
	.string "Speciál: VŮDKYNĚ STADIONU\n"
	.string "v CERULEAN MISTY!\p"
	.string "MISTY prý zbožňuje LORELEI\n"
	.string "z ELITE FOUR.$"

PokemonJournal_Text_SpecialFeatureLtSurge::
	.string "POKéMON JOURNAL\p"
	.string "Speciál: VŮDCE STADIONU\n"
	.string "ve VERMILION LT. SURGE!\p"
	.string "LT. SURGE byl prý doma v Americe\n"
	.string "pilotem.\p"
	.string "Své letadlo poháněl elektřinou\n"
	.string "z POKéMONŮ.$"

PokemonJournal_Text_SpecialFeatureErika::
	.string "POKéMON JOURNAL\p"
	.string "Speciál: VŮDKYNĚ STADIONU\n"
	.string "v CELADON ERIKA!\p"
	.string "Prý když nakoukneš do STADIONU\n"
	.string "v CELADON, často uvidíš ERIKU\l"
	.string "podřimovat.$"

PokemonJournal_Text_SpecialFeatureKoga::
	.string "POKéMON JOURNAL\p"
	.string "Speciál: VŮDCE STADIONU\n"
	.string "ve FUCHSIA KOGA!\p"
	.string "KOGA se prý důkladně vyzná\n"
	.string "v lékařství.\p"
	.string "Dokonce sám míchá léky, kterými\n"
	.string "své POKéMONY léčí.$"

PokemonJournal_Text_SpecialFeatureSabrina::
	.string "POKéMON JOURNAL\p"
	.string "Speciál: VŮDKYNĚ STADIONU\n"
	.string "v SAFFRON SABRINA!\p"
	.string "Prý SABRINA dokáže se svými\n"
	.string "POKéMONY v boji komunikovat beze\l"
	.string "slov.$"

PokemonJournal_Text_SpecialFeatureBlaine::
	.string "POKéMON JOURNAL\p"
	.string "Speciál: VŮDCE STADIONU\n"
	.string "na CINNABAR BLAINE!\p"
	.string "BLAINE si prý sundává tmavé brýle,\n"
	.string "jen když vymýšlí nové kvízové\l"
	.string "otázky.$"

PokemonJournal_Text_SpecialFeatureLorelei::
	.string "POKéMON JOURNAL\p"
	.string "Speciál:\n"
	.string "LORELEI z ELITE FOUR!\p"
	.string "LORELEI, známá svým logickým,\n"
	.string "promyšleným a chladným stylem\l"
	.string "boje, má překvapivé tajemství!$"

PokemonJournal_Text_SpecialFeatureBruno::
	.string "POKéMON JOURNAL\p"
	.string "Speciál:\n"
	.string "BRUNO z ELITE FOUR!\p"
	.string "BRUNO se prý přidal k ELITE FOUR\n"
	.string "z planoucí touhy bojovat\l"
	.string "s nejlepšími TRENÉRY.$"

PokemonJournal_Text_SpecialFeatureAgatha::
	.string "POKéMON JOURNAL\p"
	.string "Speciál:\n"
	.string "AGATHA z ELITE FOUR!\p"
	.string "AGATHA a PROF. OAK byli v mládí\n"
	.string "rivalové, kteří spolu soupeřili\l"
	.string "o prvenství mezi TRENÉRY.$"

PokemonJournal_Text_SpecialFeatureLance::
	.string "POKéMON JOURNAL\p"
	.string "Speciál:\n"
	.string "LANCE z ELITE FOUR!\p"
	.string "Dědeček LANCE je prý stařešinou\n"
	.string "slavného rodu mistrů draků.$"

PokemonJournal_Text_SpecialFeatureProfOak::
	.string "POKéMON JOURNAL\p"
