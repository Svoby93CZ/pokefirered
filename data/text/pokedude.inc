Pokedude_Text_SpeedierBattlerGoesFirst::
	.string "POKé DUDE: Rychlejší z bojovníků\n"
	.string "útočí první.$"

Pokedude_Text_MyRattataFasterThanPidgey::
	.string "Vypadá to, že můj RATTATA byl\n"
	.string "rychlejší než PIDGEY.$"

Pokedude_Text_BattlersTakeTurnsAttacking::
	.string "Bojovníci se v útocích střídají\n"
	.string "a snižují si HP.$"

Pokedude_Text_MyRattataWonGetsEXP::
	.string "Můj RATTATA srazil soupeři HP na\n"
	.string "nulu, takže vyhrává!\p"
	.string "POKéMONI, kteří se boje účastnili,\n"
	.string "získají zkušenosti.\p"
	.string "Když POKéMON nasbírá dost\n"
	.string "zkušeností, postoupí na vyšší\l"
	.string "úroveň.\p"
	.string "S vyšší úrovní je tvůj POKéMON\n"
	.string "silnější než předtím.$"

Pokedude_Text_UhOhRattataPoisoned::
	.string "POKé DUDE: Ajaj…\n"
	.string "Můj RATTATA je otrávený…\p"
	.string "Otrávený POKéMON neustále ztrácí\n"
	.string "HP.$"

Pokedude_Text_HealStatusRightAway::
	.string "Když má POKéMON problém se\n"
	.string "stavem, hned ho vyléč.$"

Pokedude_Text_UsingItemTakesTurn::
	.string "Jenže použití předmětu na\n"
	.string "POKéMONA zabere jedno kolo.\p"
	.string "Teď je na tahu soupeř!$"

Pokedude_Text_YayWeManagedToWin::
	.string "Jupí!\n"
	.string "Podařilo se nám vyhrát!$"

Pokedude_Text_WaterNotVeryEffectiveAgainstGrass::
	.string "POKé DUDE: Útok BUBBLE je typu\n"
	.string "WATER.\p"
	.string "Cílový ODDISH je POKéMON typu\n"
	.string "GRASS/POISON.\p"
	.string "Útok typu WATER POKéMON typu\n"
	.string "GRASS pohltí…\p"
	.string "Takže útok není moc účinný\n"
	.string "a způsobí jen poloviční zranění.$"

Pokedude_Text_GrassEffectiveAgainstWater::
	.string "Ajaj, to není dobré!\p"
	.string "Právě použitý útok ABSORB je typu\n"
	.string "GRASS.\p"
	.string "POLIWAG je POKéMON typu WATER.\p"
	.string "ABSORB je tedy velmi účinný\n"
	.string "a zranění se zdvojnásobí.$"

Pokedude_Text_LetsTryShiftingMons::
	.string "S takovou dvojicí se vyhrát nedá…\p"
	.string "Zkusíme vyměnit POKéMONA!$"

Pokedude_Text_ShiftingUsesTurn::
	.string "Výměna POKéMONA zabere jedno\n"
	.string "kolo.\p"
	.string "Teď je na tahu soupeř.$"

Pokedude_Text_ButterfreeDoubleResistsGrass::
	.string "BUTTERFREE je POKéMON typu\n"
	.string "BUG/FLYING.\p"
	.string "Proti němu útok typu GRASS…\p"
	.string "…způsobí POKéMONOVI typu BUG jen\n"
	.string "poloviční zranění…\p"
	.string "…a POKéMONOVI typu FLYING taky\n"
	.string "jen poloviční.\p"
	.string "BUTTERFREE jako POKéMON typu\n"
	.string "BUG/FLYING proto dostane jen\l"
	.string "čtvrtinu běžného zranění.$"

Pokedude_Text_ButterfreeGoodAgainstOddish::
	.string "ODDISH je POKéMON typu\n"
	.string "GRASS/POISON.\p"
	.string "Útoky typu FLYING nebo PSYCHIC\n"
	.string "jsou proti němu velmi účinné.\p"
	.string "Takové útoky způsobí dvojnásobné\n"
	.string "zranění.\p"
	.string "Tak jdeme na to!$"

Pokedude_Text_YeahWeWon::
	.string "Jo!\n"
	.string "Vyhráli jsme!$"

Pokedude_Text_WeakenMonBeforeCatching::
	.string "POKé DUDE: Když chceš POKéMONA\n"
	.string "chytit, neházej POKé BALLY hned.\p"
	.string "Nejdřív ho musíš oslabit a snížit\n"
	.string "mu HP.$"

Pokedude_Text_BestIfTargetStatused::
	.string "Dobře, to by mělo stačit.\p"
	.string "Ale pokud to jde, je nejlepší,\n"
	.string "když má cíl nějaký problém se\l"
	.string "stavem.\p"
	.string "Třeba spícího nebo paralyzovaného\n"
	.string "POKéMONA chytíš snáz.$"

Pokedude_Text_CantDoubleUpOnStatus::
	.string "Takhle se POKéMON chytí mnohem\n"
	.string "snáz!\p"
	.string "Jo, a když POKéMONA paralyzuješ,\n"
	.string "nemůžeš ho k tomu ještě uspat.\p"
	.string "Jinými slovy, problémy se stavem se\n"
	.string "nesčítají, jasné?$"

Pokedude_Text_LetMeThrowBall::
	.string "Dobře!\n"
	.string "Teď hodím POKé BALL!$"

Pokedude_Text_PickBestKindOfBall::
	.string "Než hodíš POKé BALL, zvaž stav\n"
	.string "a typ POKéMONA a vyber BALL,\l"
	.string "který bude nejlepší.$"
